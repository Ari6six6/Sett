# spec: code-sett-8
# out:  $SETT/out/code-sett-8
#
# The dogfood gym. Every point asks for a real utility that SETT itself wants,
# tested against SETT's real files. A pass here is not a score — it is a tool
# you can keep.
#
# Same four fields as every other spec. `check:` runs a hidden test; the model
# sees only `do:`.
#
# Formats the model must handle, all real and all on this box:
#   state.tsv   ts \t id \t verdict \t note   (append-only, latest line wins)
#   *.probe     "## <id> <slug>" then do: / check:, continuing until the next key
#   vault       "<sha256>  <path>" per line

## 1 state-latest
do:    Write a Python file $OUT/1.py defining latest(path), where path is a str filesystem path, which reads a SETT state.tsv — tab-separated columns timestamp, id, verdict, note — and returns a dict mapping each id to its LAST verdict in file order. Later lines override earlier ones for the same id. An empty file returns an empty dict.
check: python3 -c 'import importlib.util,os,tempfile,pathlib;s=importlib.util.spec_from_file_location("m",os.environ["OUT"]+"/1.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m);p=tempfile.mktemp();pathlib.Path(p).write_text("t1\t1\tFAIL\tx\nt2\t2\tPASS\t\nt3\t1\tPASS\t\n");r=m.latest(p);assert r=={"1":"PASS","2":"PASS"}, r;q=tempfile.mktemp();pathlib.Path(q).write_text("");assert m.latest(q)=={}'

## 2 state-summary
do:    Write a Python file $OUT/2.py defining summary(path) which reads a SETT state.tsv — tab-separated columns timestamp, id, verdict, note, exactly as in point 1 — and returns a dict with keys "pass", "fail", "error" holding how many ids have that verdict as their LAST recorded verdict. Verdicts in the file are upper-case PASS, FAIL, ERROR. Group by id first: an id with three lines contributes exactly one count, using its last line. path is a str.
check: python3 -c 'import importlib.util,os,tempfile,pathlib;s=importlib.util.spec_from_file_location("m",os.environ["OUT"]+"/2.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m);p=tempfile.mktemp();pathlib.Path(p).write_text("t\t1\tFAIL\t\nt\t1\tPASS\t\nt\t2\tERROR\t\nt\t3\tFAIL\t\n");r=m.summary(p);assert r["pass"]==1 and r["fail"]==1 and r["error"]==1, r;assert m.summary("$SETT/fixtures/state-3pass.tsv")["pass"]==3'

## 3 spec-points
do:    Write a Python file $OUT/3.py defining points(path) which reads the SETT .probe spec at $SETT/fixtures/specs/sample-12.probe and returns a list of (id, slug) tuples in file order. A point header looks like "## 11 stix-bytes" — id is the first token after ##, slug is the rest of the line.
check: python3 -c 'import importlib.util,os;s=importlib.util.spec_from_file_location("m",os.environ["OUT"]+"/3.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m);r=[tuple(x) for x in m.points("$SETT/fixtures/specs/sample-12.probe")];assert len(r)==12, len(r);assert r[0]==("1","epss-max"), r[0];assert r[-1]==("12","stix-tactic-names"), r[-1]'

## 4 spec-grounded-ratio
do:    Write a Python file $OUT/4.py defining grounded_ratio(path) which reads a SETT .probe spec (test it on $SETT/fixtures/specs/sample-12.probe) and returns the fraction (float) of points whose "do:" line contains an absolute path starting with /home/. A point's do: is the line beginning "do:" after its "## " header.
check: python3 -c 'import importlib.util,os;s=importlib.util.spec_from_file_location("m",os.environ["OUT"]+"/4.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m);r=m.grounded_ratio("$SETT/fixtures/specs/sample-12.probe");assert abs(r-5/12)<1e-6, r;r2=m.grounded_ratio("$SETT/fixtures/specs/sample-3.probe");assert abs(r2-1/3)<1e-6, r2'

## 5 vault-verify
do:    Write a Python file $OUT/5.py defining verify(manifest_path) which reads a sha256 manifest whose lines are "<hexdigest>  <absolute path>" (two spaces), recomputes each file's sha256, and returns a list of paths whose digest no longer matches. Missing files count as mismatched.
check: python3 -c 'import importlib.util,os,tempfile,pathlib,hashlib;s=importlib.util.spec_from_file_location("m",os.environ["OUT"]+"/5.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m);d=tempfile.mkdtemp();a=os.path.join(d,"a.txt");pathlib.Path(a).write_text("hello");h=hashlib.sha256(b"hello").hexdigest();mf=os.path.join(d,"m.sha256");pathlib.Path(mf).write_text(h+"  "+a+"\n");assert m.verify(mf)==[], m.verify(mf);pathlib.Path(a).write_text("changed");assert m.verify(mf)==[a], m.verify(mf);pathlib.Path(mf).write_text(h+"  "+os.path.join(d,"gone.txt")+"\n");assert len(m.verify(mf))==1'

## 6 results-table
do:    Write a Python file $OUT/6.py defining table(rows) which takes a list of dicts each having keys "model", "gym", "score" and returns a GitHub-flavoured markdown table as a string. First line is the header "| model | gym | score |", second the separator "|---|---|---|", then one row per entry in the given order. An empty list still returns the header and separator: the table always has those two lines.
check: python3 -c 'import importlib.util,os;s=importlib.util.spec_from_file_location("m",os.environ["OUT"]+"/6.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m);t=m.table([{"model":"glm-q4","gym":"code-10","score":"7/10"},{"model":"glm-q6","gym":"code-10","score":"6/10"}]);L=[x.strip() for x in t.strip().splitlines()];assert L[0]=="| model | gym | score |", L[0];assert L[1]=="|---|---|---|", L[1];assert L[2]=="| glm-q4 | code-10 | 7/10 |", L[2];assert len(L)==4, L;assert m.table([]).strip().splitlines()[0]=="| model | gym | score |"'

## 7 extract-checks
do:    Write a Python file $OUT/7.py defining checks(path) which reads a SETT .probe spec (test it on $SETT/fixtures/specs/sample-12.probe) and returns a dict mapping point id to its check text. A check begins on the line starting "check:" and continues onto any following lines until a blank line or a line starting "## ". Strip the leading "check:" and surrounding whitespace; join continuation lines with a newline. Every point in a spec has exactly one check, so the returned dict has exactly one entry per point — use that to check your own work. path is a str.
check: python3 -c 'import importlib.util,os;s=importlib.util.spec_from_file_location("m",os.environ["OUT"]+"/7.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m);r=m.checks("$SETT/fixtures/specs/sample-12.probe");assert len(r)==12, len(r);assert all(v.strip() for v in r.values());assert "stat -c%s" in r["1"] or "epss" in r["1"].lower(), r["1"][:80];assert not any(v.startswith("check:") for v in r.values())'

## 8 scaffold-spec
do:    Write a Python file $OUT/8.py defining scaffold(name, outdir, questions) where questions is a list of dicts with keys "slug", "do", "check". It returns a complete SETT .probe spec as a string: a "# spec: <name>" line, a "# out:  <outdir>" line, a blank line, then for each question a "## <n> <slug>" header numbered from 1, a "do:    <do>" line and a "check: <check>" line, with a blank line between points.
check: python3 -c 'import importlib.util,os;s=importlib.util.spec_from_file_location("m",os.environ["OUT"]+"/8.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m);t=m.scaffold("demo","/tmp/demo",[{"slug":"a","do":"do a","check":"true"},{"slug":"b","do":"do b","check":"false"}]);L=t.splitlines();assert L[0]=="# spec: demo", L[0];assert L[1].startswith("# out:") and "/tmp/demo" in L[1], L[1];assert "## 1 a" in t and "## 2 b" in t, t;assert "do:    do a" in t, t;assert "check: true" in t, t;import re;assert len(re.findall(r"^## ",t,flags=re.M))==2'
