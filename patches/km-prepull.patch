+# Pull the GGUF with N parallel HTTP range requests instead of letting
+# llama.cpp fetch it single-stream.
+#
+# Hugging Face throttles PER CONNECTION, not per client. Measured on two boxes
+# on 2026-07-31, same wire, same minute:
+#
+#     1 connection    ~5 MB/s     18GB in ~50 minutes
+#     8 connections  ~48 MB/s
+#    16 connections  ~67-77 MB/s  18GB in ~5 minutes
+#
+# That is 45 minutes of paid idle on every cold box. The file is verified
+# against Hugging Face's own x-linked-etag, which for an LFS object IS the
+# sha256 of the content, so a truncated or corrupted assembly cannot be served.
+# On failure this returns nonzero and the caller falls back to -hf, which is
+# slow but always worked.
+_prepull_gguf() { # $1=repo $2=quant-or-file  -> echoes box-side path, or fails
+  local repo="$1" want="$2" n=16
+  local script; script=$(cat <<'PREPULL'
+set -uo pipefail
+REPO="$1"; WANT="$2"; N="$3"; D=/workspace/models
+mkdir -p "$D" 2>/dev/null || D="$HOME/models"; mkdir -p "$D"; cd "$D" || exit 1
+# Resolve the quant label (e.g. Q4_K_M) to an actual filename in the repo.
+FILE="$(curl -s --max-time 60 "https://huggingface.co/api/models/$REPO"   | python3 -c "import json,sys;d=json.load(sys.stdin);w=sys.argv[1];c=[f['rfilename'] for f in d.get('siblings',[]) if f['rfilename'].endswith('.gguf') and (w==f['rfilename'] or w in f['rfilename'])];print(c[0] if c else '')" "$WANT" 2>/dev/null)"
+[ -n "$FILE" ] || { echo "PREPULL-FAIL no gguf matching $WANT"; exit 1; }
+U="https://huggingface.co/$REPO/resolve/main/$FILE"
+[ -s "$D/$FILE" ] && { echo "PREPULL-OK $D/$FILE"; exit 0; }
+H="$(curl -sIL --max-time 60 "$U")"
+SZ="$(printf '%s' "$H" | grep -i '^content-length:' | tail -1 | tr -dc '0-9')"
+# cut the header NAME first: 'x-linkEDEATag' would otherwise donate 'edea'
+SHA="$(printf '%s' "$H" | grep -i '^x-linked-etag:' | tail -1 | cut -d: -f2- | tr -dc '0-9a-f')"
+[ -n "$SZ" ] || { echo "PREPULL-FAIL no content-length"; exit 1; }
+CH=$(( (SZ + N - 1) / N )); rm -f part.*
+for i in $(seq 0 $((N-1))); do
+  s=$(( i*CH )); e=$(( s+CH-1 )); [ "$e" -ge "$SZ" ] && e=$((SZ-1))
+  curl -sL --retry 5 --retry-all-errors -r "$s-$e" -o "part.$(printf '%03d' "$i")" "$U" &
+done
+wait
+GOT=$(cat part.* 2>/dev/null | wc -c)
+[ "$GOT" -eq "$SZ" ] || { echo "PREPULL-FAIL assembled $GOT != $SZ"; rm -f part.*; exit 1; }
+cat part.* > "$FILE" && rm -f part.*
+if [ -n "$SHA" ]; then
+  A="$(sha256sum "$FILE" | cut -d" " -f1)"
+  [ "$A" = "$SHA" ] || { echo "PREPULL-FAIL sha $A != $SHA"; rm -f "$FILE"; exit 1; }
+fi
+echo "PREPULL-OK $D/$FILE"
+PREPULL
+)
+  rrun "bash -s -- $(printf '%q %q %q' "$repo" "$want" "$n") <<'EOS'
+$script
+EOS" 1800
+  case "$ROUT" in
+    *PREPULL-OK*) printf '%s' "$ROUT" | sed -n 's/.*PREPULL-OK \(.*\)/\1/p' | tail -1; return 0 ;;
+    *) return 1 ;;
+  esac
+}
